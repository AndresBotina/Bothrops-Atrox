# Copia este archivo a .env y rellena los valores. .env NO se versiona.

# Cadena de conexión a Postgres (driver psycopg3, obligatoria). Base de TRABAJO/real.
DATABASE_URL=postgresql+psycopg://valuebet:valuebet@localhost:5433/valuebet

# Base de TESTS, SEPARADA y desechable. pytest la usa en exclusiva (migra y trunca).
# NUNCA debe coincidir con DATABASE_URL: la suite aborta si coinciden o si falta.
# Crea la base una vez:  docker exec valuebet_db createdb -U valuebet valuebet_test
#   (o con Postgres local:  createdb valuebet_test)
TEST_DATABASE_URL=postgresql+psycopg://valuebet:valuebet@localhost:5433/valuebet_test

# Nivel de logging (DEBUG, INFO, WARNING, ERROR). Por defecto INFO.
LOG_LEVEL=INFO

# Clave de API-Football (API-Sports). Necesaria sólo para `valuebet fetch ...`.
# Consíguela en https://dashboard.api-football.com/ . NUNCA la subas a git.
APISPORTS_KEY=
